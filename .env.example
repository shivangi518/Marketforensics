# Copy to .env and fill in your key. Never commit .env.
# Agents use Gemini's free tier. Get a key at https://aistudio.google.com/apikey

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Groq's free daily token cap is easy to hit, so it is not the default.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
